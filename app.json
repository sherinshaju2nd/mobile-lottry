{
  "expo": {
    "name": "Kerala Lottery Results Today",
    "slug": "kerala-lottery-results",
    "scheme": "keralalottery",
    "version": "1.0.9",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "assets/icon.png",
      "assets/adaptive-icon.png",
      "assets/splash.png",
      "assets/notification-icon.png",
      "assets/favicon.png",
      "assets/barcode_hint.png"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keralalotteryresultstoday.app",
      "buildNumber": "4",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Kerala Lottery Results to access your camera to scan lottery ticket barcodes.",
        "NSMicrophoneUsageDescription": "Allow Kerala Lottery Results to access your microphone to ask lottery questions via voice in Malayalam and English.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "upi",
          "tez",
          "gpay",
          "phonepe",
          "paytmmp",
          "paytm",
          "credpay",
          "bhim",
          "mobikwik"
        ]
      }
    },
    "android": {
      "package": "com.keralalotteryresultstoday.app",
      "versionCode": 14,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3C5D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "35fac119-81c5-49cb-a58d-687f74cb51ba"
      }
    },
    "plugins": [
      "./plugins/withLargeScreenSupport",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#0B3C5D",
          "android": {
            "image": "./assets/splash.png",
            "imageWidth": 260,
            "resizeMode": "contain",
            "backgroundColor": "#0B3C5D"
          },
          "ios": {
            "image": "./assets/splash.png",
            "imageWidth": 260,
            "resizeMode": "contain",
            "backgroundColor": "#0B3C5D"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn sun.misc.**\n-dontwarn javax.annotation.**\n-keepattributes *Annotation*\n-keepattributes Signature\n-keepattributes EnclosingMethod\n-keep class androidx.core.splashscreen.** { *; }\n-dontwarn androidx.core.splashscreen.**\n-keep class expo.modules.splashscreen.** { *; }\n-dontwarn expo.modules.splashscreen.**\n-keep class android.view.SurfaceControl** { *; }\n-dontwarn android.view.SurfaceControl**\n-keep public class com.horcrux.svg.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-dontwarn com.facebook.react.turbomodule.**\n-keep class com.facebook.react.** { *; }\n-keep class com.facebook.react.uimanager.** { *; }"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B3C5D",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kerala Lottery Results to access your camera to scan ticket barcodes."
        }
      ],
      "expo-audio"
    ]
  }
}
